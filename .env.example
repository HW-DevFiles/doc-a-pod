HOST=0.0.0.0
PORT=3000
# Extra host names for the API, comma-separated (localhost, IPs, *.local, *.ts.net always work)
# ALLOWED_HOSTS=
DATA_DIR=./data
MODEL_CACHE_DIR=./.cache
SCRIPT_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
VOICE_PROVIDER=kokoro
# Optional; never commit a real key. Requires two different voice IDs.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_MAYA=
# ELEVENLABS_VOICE_LEO=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# For a zero-model smoke test: SCRIPT_PROVIDER=demo VOICE_PROVIDER=demo
